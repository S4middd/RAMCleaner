        {
            Border card = MakeCard(new Thickness(0, 0, 10, 0));
            StackPanel csp = new StackPanel();
            card.Child = csp;
            Grid.SetColumn(card, 1);

            CardLabel(csp, "KONTROL", BrTeal);

            _btnClean = new Button();
            _btnClean.Content = "Bersihkan RAM";
            _btnClean.Height = 46;
            _btnClean.FontSize = 15;
            _btnClean.FontWeight = FontWeights.Bold;
            _btnClean.Margin = new Thickness(0, 12, 0, 0);
            _btnClean.Style = ButtonStyle(BrBlue, BrBlueHi, BrBg);
            csp.Children.Add(_btnClean);

            _btnRefresh = new Button();
            _btnRefresh.Content = "Refresh";
            _btnRefresh.Height = 34;
            _btnRefresh.Margin = new Thickness(0, 8, 0, 0);
            _btnRefresh.FontSize = 12;
            _btnRefresh.Style = ButtonStyle(BrSurface, BrSurfaceHi, BrText);
            _btnRefresh.Click += delegate { UpdateDisplay(); };
            csp.Children.Add(_btnRefresh);

            _btnRestartExplorer = new Button();
            _btnRestartExplorer.Content = "Restart Explorer";
            _btnRestartExplorer.Height = 40;
            _btnRestartExplorer.Margin = new Thickness(0, 14, 0, 0);
            _btnRestartExplorer.FontSize = 13;
            _btnRestartExplorer.FontWeight = FontWeights.Bold;
            _btnRestartExplorer.Style = ButtonStyle(BrYellow, BrSurfaceHi, BrBg);
            csp.Children.Add(_btnRestartExplorer);

            _chkAggressive = new CheckBox();
            _chkAggressive.Content = "Mode mendalam: proses sistem non-kritis + file cache";
            _chkAggressive.FontSize = 11;
            _chkAggressive.Foreground = BrSubtext;
            // Sengaja OFF secara default: mode ini menyapu dwm, svchost dan explorer,
            // yang bikin desktop tersendat dan biasanya meninggalkan mesin lebih
            // lambat. Harus jadi pilihan sadar, bukan default.
            _chkAggressive.IsChecked = false;
            _chkAggressive.Margin = new Thickness(2, 14, 0, 0);
            _chkAggressive.ToolTip =
                "Menyapu working set semua proses kecuali yang kritis, plus system "
                + "working set (file cache), dan mem-flush modified page list. "
                + "Efeknya lebih besar tapi desktop bisa tersendat sesaat.";
            csp.Children.Add(_chkAggressive);

            StackPanel autoRow = new StackPanel();
            autoRow.Orientation = Orientation.Horizontal;
            autoRow.Margin = new Thickness(2, 8, 0, 0);

            _chkAuto = new CheckBox();
            _chkAuto.Content = "Auto bersihkan bila RAM di atas ";
            _chkAuto.FontSize = 11;
            _chkAuto.Foreground = BrSubtext;
            _chkAuto.VerticalAlignment = VerticalAlignment.Center;
            autoRow.Children.Add(_chkAuto);

            _txtThreshold = new TextBox();
