        private static UIElement BuildProcessCard()
        {
            Border card = MakeCard(new Thickness(0));
            Grid pg = new Grid();
            AddRow(pg, GridLength.Auto);
            AddRow(pg, new GridLength(1, GridUnitType.Star));
            card.Child = pg;
            Grid.SetColumn(card, 2);

            TextBlock listLabel = new TextBlock();
            listLabel.Text = "PROSES TERATAS BERDASARKAN PENGGUNAAN RAM (klik kanan untuk aksi)";
            listLabel.FontSize = 12;
            listLabel.FontWeight = FontWeights.Bold;
            listLabel.Foreground = BrSubtext;
            Grid.SetRow(listLabel, 0);
            pg.Children.Add(listLabel);

            ListView lv = new ListView();
            lv.Margin = new Thickness(0, 8, 0, 0);
            lv.Background = BrBg;
            lv.BorderBrush = BrSurface;
            lv.BorderThickness = new Thickness(1);
            Grid.SetRow(lv, 1);
            lv.ItemsSource = _procs;

            GridView gv = new GridView();

            GridViewColumn c1 = new GridViewColumn();
            c1.Header = "Nama Proses";
            c1.DisplayMemberBinding = new Binding("Name");
            c1.Width = 280;
            gv.Columns.Add(c1);

            GridViewColumn c2 = new GridViewColumn();
            c2.Header = "PID";
            c2.DisplayMemberBinding = new Binding("Id");
            c2.Width = 70;
            gv.Columns.Add(c2);

            GridViewColumn c3 = new GridViewColumn();
            c3.Header = "RAM (MB)";
            Binding memBinding = new Binding("MemMB");
            memBinding.StringFormat = "N1";
            c3.DisplayMemberBinding = memBinding;
            c3.Width = 110;
            gv.Columns.Add(c3);

            lv.View = gv;

            Style headerStyle = new Style(typeof(GridViewColumnHeader));
            headerStyle.Setters.Add(new Setter(GridViewColumnHeader.BackgroundProperty, BrSurface));
            headerStyle.Setters.Add(new Setter(GridViewColumnHeader.ForegroundProperty, BrText));
            headerStyle.Setters.Add(new Setter(GridViewColumnHeader.BorderThicknessProperty, new Thickness(0)));
            headerStyle.Setters.Add(new Setter(GridViewColumnHeader.PaddingProperty, new Thickness(6, 6, 6, 6)));
            lv.Resources.Add(typeof(GridViewColumnHeader), headerStyle);

            Style itemStyle = new Style(typeof(ListViewItem));
            itemStyle.Setters.Add(new Setter(ListViewItem.ForegroundProperty, BrText));
            itemStyle.Setters.Add(new Setter(ListViewItem.PaddingProperty, new Thickness(4, 2, 4, 2)));
            lv.ItemContainerStyle = itemStyle;

            ContextMenu cm = new ContextMenu();
            MenuItem miClean = new MenuItem();
            MenuItem miKill = new MenuItem();

            miClean.Click += delegate { CleanSingle(cm.Tag as ProcItem); };
            cm.Items.Add(miClean);
            miKill.Click += delegate { KillSingle(cm.Tag as ProcItem); };
            cm.Items.Add(miKill);

            cm.Opened += delegate
            {
                // Selama menu terbuka, daftar tidak di-refresh supaya baris tidak
                // bergeser / terganti di bawah kursor.
                _menuOpen = true;

                ProcItem sel = _lvProcs.SelectedItem as ProcItem;
                cm.Tag = sel;
                bool usable = sel != null && !_isCleaning;
                miClean.IsEnabled = usable;
                miKill.IsEnabled = usable;
                miClean.Header = sel != null
                    ? "Bersihkan '" + sel.Name + "'"
                    : "Bersihkan proses ini";
                miKill.Header = sel != null
                    ? "Akhiri '" + sel.Name + "'"
                    : "Akhiri proses ini";
            };
            cm.Closed += delegate { _menuOpen = false; };

            lv.ContextMenu = cm;
            _procMenu = cm;

            lv.PreviewMouseRightButtonDown += delegate(object sender, MouseButtonEventArgs args)
            {
                DependencyObject src = args.OriginalSource as DependencyObject;
                if (src == null) { return; }
                ListViewItem container =
                    ItemsControl.ContainerFromElement(lv, src) as ListViewItem;
                if (container != null)
                {
                    container.IsSelected = true;
                }
            };

            _lvProcs = lv;
            pg.Children.Add(lv);

            return card;
        }

        private static void WireEvents()
        {
            _btnClean.Click += delegate { CleanRam(false); };
            _btnRestartExplorer.Click += delegate { RestartExplorer(); };
            _txtThreshold.TextChanged += delegate { ValidateThreshold(false); };
            _chkAuto.Checked += delegate { ValidateThreshold(true); };
        }

        private static Style ButtonStyle(Brush normal, Brush hover, Brush foreground)
        {
            Style st = new Style(typeof(Button));
            st.Setters.Add(new Setter(Button.BackgroundProperty, normal));
            st.Setters.Add(new Setter(Button.ForegroundProperty, foreground));
            st.Setters.Add(new Setter(Button.BorderThicknessProperty, new Thickness(0)));
            st.Setters.Add(new Setter(Button.CursorProperty, Cursors.Hand));

            Trigger t = new Trigger();
            t.Property = UIElement.IsMouseOverProperty;
            t.Value = true;
            t.Setters.Add(new Setter(Button.BackgroundProperty, hover));
            st.Triggers.Add(t);

            Trigger pressed = new Trigger();
            pressed.Property = Button.IsPressedProperty;
            pressed.Value = true;
            pressed.Setters.Add(new Setter(Button.BackgroundProperty, hover));
            st.Triggers.Add(pressed);

            return st;
        }

        private static Brush Solid(Color c)
        {
            SolidColorBrush b = new SolidColorBrush(c);
            b.Freeze();
            return b;
        }

        private static Run Tint(string text, Brush color)
        {
            Run r = new Run(text);
            r.Foreground = color;
            return r;
        }

        // ===================== Render meter =====================

        private static void RefreshFillWidth()
        {
            double avail = _meter.ActualWidth - 2.0;
            if (avail <= 0) { return; }
            double frac = Math.Max(0, Math.Min(100, _lastPct)) / 100.0;
            _barFill.Width = frac * avail;
        }

        private static void RefreshStackWidths()
        {
            double inUse = Math.Max(0, _lastInUseFrac);
            double standby = Math.Max(0, _lastStandbyFrac);
            double free = 1.0 - inUse - standby;
            if (free < 0) { free = 0; }

            _stack.ColumnDefinitions[0].Width = new GridLength(inUse, GridUnitType.Star);
            _stack.ColumnDefinitions[1].Width = new GridLength(standby, GridUnitType.Star);
            _stack.ColumnDefinitions[2].Width = new GridLength(free, GridUnitType.Star);
        }

        private static void RedrawHistory()
        {
            if (_histCanvas == null) { return; }

            double w = _histCanvas.ActualWidth;
            double h = _histCanvas.ActualHeight;
            if (w <= 1 || h <= 1) { return; }

            _histGridMid.X1 = 0;
            _histGridMid.X2 = w;
            _histGridMid.Y1 = h * 0.5;
            _histGridMid.Y2 = h * 0.5;

            _histGridHigh.X1 = 0;
            _histGridHigh.X2 = w;
            _histGridHigh.Y1 = h * 0.15;
            _histGridHigh.Y2 = h * 0.15;

            int n = _history.Count;
            if (n < 2)
            {
                _histLine.Points = new PointCollection();
                _histFill.Points = new PointCollection();
                return;
            }

            // Data terbaru rata kanan, jadi grafik "masuk" dari sisi kanan.
            double step = w / (HistoryMax - 1);
            double x0 = w - (n - 1) * step;
            if (x0 < 0) { x0 = 0; }

            PointCollection line = new PointCollection(n);
            for (int i = 0; i < n; i++)
            {
                double pct = Math.Max(0, Math.Min(100, _history[i]));
                double x = x0 + i * step;
                double y = h - (pct / 100.0) * h;
                if (y < 1) { y = 1; }
                if (y > h - 1) { y = h - 1; }
                line.Add(new Point(x, y));
            }
            _histLine.Points = line;

            PointCollection area = new PointCollection(n + 2);
            area.Add(new Point(line[0].X, h));
            for (int i = 0; i < line.Count; i++) { area.Add(line[i]); }
            area.Add(new Point(line[line.Count - 1].X, h));
            _histFill.Points = area;
        }

        private static string FmtGb(ulong bytes)
        {
            return string.Format("{0:N2} GB", bytes / 1073741824.0);
        }

        // ===================== Tick & display =====================

        private static void OnTick()
        {
            _tickCounter++;

            // Snapshot proses cukup tiap 3 tick (6 detik); saat jendela
            // tersembunyi di tray tidak ada yang melihat daftarnya.
            bool snap = _window.IsVisible && _tickCounter % 3 == 0;
            UpdateDisplay(snap);

            // Saat di tray, trim ulang tiap ~1 menit supaya footprint tetap
            // rendah walau timer dan tooltip sesekali memfault halaman balik.
            if (!_window.IsVisible && _tickCounter % 12 == 0)
            {
                TrimOwnWorkingSet();
            }

            CheckAutoClean();
        }

        private static void UpdateDisplay(bool snapshotProcesses = true)
        {
            try
            {
                MemApi.MEMORYSTATUSEX s;
                if (!MemApi.TryGetStatus(out s))
                {
                    // Jangan tampilkan 0% seolah-olah itu data valid. _lastPct
                    // dibuat negatif supaya CheckAutoClean tidak memakai angka
                    // basi dari tick sebelumnya.
                    _lastPct = -1;
                    _txtUsage.Text = "?";
                    _txtUsage.Foreground = BrRed;
                    _txtDetail.Text = "GlobalMemoryStatusEx gagal (error "
                        + Marshal.GetLastWin32Error() + ")";
                    Tray.SetTooltip("RAM Cleaner - status memori tidak terbaca");
                    return;
                }

                int pct = (int)s.dwMemoryLoad;
                _lastPct = pct;

                Brush meterBrush;
                if (pct < 60) { meterBrush = BrGreen; }
                else if (pct < 85) { meterBrush = BrYellow; }
                else { meterBrush = BrRed; }

                _txtUsage.Text = pct + "%";
                _txtUsage.Foreground = meterBrush;
                _barFill.Background = meterBrush;
                RefreshFillWidth();

                ulong used = s.ullTotalPhys - s.ullAvailPhys;
                _txtDetail.Text = string.Format(
                    "Terpakai {0}   |   Total {1}   |   Tersedia {2}",
                    FmtGb(used), FmtGb(s.ullTotalPhys), FmtGb(s.ullAvailPhys));

                UpdateBreakdown();
                PushHistory(pct);

                Tray.SetTooltip("RAM Cleaner - " + pct + "% terpakai");

                // Enumerasi seluruh proses itu mahal; hanya saat diminta, tidak
                // sedang membersihkan, dan menu konteks tidak terbuka.
                if (snapshotProcesses && !_isCleaning && !_menuOpen)
                {
                    MergeProcesses(SnapshotProcesses());
                }
            }
            catch (Exception ex)
            {
                Log.Write("UpdateDisplay gagal: " + ex.Message);
            }
        }

        private static void UpdateBreakdown()
        {
            MemApi.MemBreakdown b = MemApi.GetBreakdown();
            if (b.TotalBytes == 0)
            {
                _txtBreakdown.Inlines.Clear();
                _txtBreakdown.Inlines.Add(Tint("Rincian memori tidak tersedia", BrMuted));
                return;
            }

            double total = b.TotalBytes;
            _lastInUseFrac = b.InUseBytes / total;
            _lastStandbyFrac = b.StandbyBytes / total;
            RefreshStackWidths();

            _txtBreakdown.Inlines.Clear();
            _txtBreakdown.Inlines.Add(Tint("● ", BrGreen));
            _txtBreakdown.Inlines.Add(Tint("Terpakai " + FmtGb(b.InUseBytes) + "   ", BrSubtext));
            _txtBreakdown.Inlines.Add(Tint("● ", BrBlue));
            _txtBreakdown.Inlines.Add(Tint("Standby " + FmtGb(b.StandbyBytes) + "   ", BrSubtext));
            _txtBreakdown.Inlines.Add(Tint("● ", BrMuted));
            _txtBreakdown.Inlines.Add(Tint("Bebas " + FmtGb(b.FreeBytes), BrSubtext));

            if (!b.Accurate)
            {
                _txtBreakdown.Inlines.Add(Tint("   (perkiraan)", BrMuted));
            }
        }

        private static void PushHistory(int pct)
        {
            _history.Add(pct);
            if (_history.Count > HistoryMax)
            {
                _history.RemoveRange(0, _history.Count - HistoryMax);
            }
            RedrawHistory();
        }

        // ===================== Daftar proses =====================

        private static List<ProcItem> SnapshotProcesses()
        {
            List<ProcItem> list = new List<ProcItem>();
            Process[] procs = Process.GetProcesses();
            foreach (Process p in procs)
            {
                try
                {
                    long ws = p.WorkingSet64;
                    if (ws <= 10485760L) { continue; }

                    ProcItem it = new ProcItem();
                    it.Name = p.ProcessName;
                    it.Id = p.Id;
                    it.MemMB = Math.Round(ws / 1048576.0, 1);
                    it.StartTicks = SafeStartTicks(p);
                    list.Add(it);
                }
                catch { }
                finally
                {
                    try { p.Dispose(); } catch { }
                }
            }

            list.Sort(delegate(ProcItem a, ProcItem b) { return b.MemMB.CompareTo(a.MemMB); });
            if (list.Count > 25)
            {
                list.RemoveRange(25, list.Count - 25);
            }
            return list;
        }

        private static long SafeStartTicks(Process p)
        {
            // StartTime melempar Access Denied untuk sebagian proses sistem.
            try { return p.StartTime.Ticks; }
            catch { return 0; }
        }

        // Update di tempat supaya seleksi dan posisi scroll tidak hilang setiap
        // 2 detik (dulu ItemsSource diganti dengan List baru).
        private static void MergeProcesses(List<ProcItem> snap)
        {
            Dictionary<int, ProcItem> byId = new Dictionary<int, ProcItem>(snap.Count);
            for (int i = 0; i < snap.Count; i++)
            {
                byId[snap[i].Id] = snap[i];
            }

            for (int i = _procs.Count - 1; i >= 0; i--)
            {
                if (!byId.ContainsKey(_procs[i].Id))
                {
                    _procs.RemoveAt(i);
                }
            }

            // Samakan urutan dengan snapshot. Invarian: setelah indeks i
            // diproses, posisi 0..i-1 persis sama dengan snapshot 0..i-1,
            // jadi urutan tidak bergeser meleset setelah ada proses keluar.
            for (int i = 0; i < snap.Count; i++)
            {
                ProcItem fresh = snap[i];
                int cur = IndexOfPid(fresh.Id);
                if (cur < 0)
                {
                    _procs.Insert(i, fresh);
                    continue;
                }

                ProcItem existing = _procs[cur];
                existing.Name = fresh.Name;
                existing.MemMB = fresh.MemMB;
                existing.StartTicks = fresh.StartTicks;
                if (cur != i)
                {
                    _procs.Move(cur, i);
                }
            }
        }

        private static int IndexOfPid(int pid)
        {
            for (int i = 0; i < _procs.Count; i++)
            {
                if (_procs[i].Id == pid) { return i; }
            }
            return -1;
        }

        // Memastikan PID masih milik proses yang sama sebelum kita bertindak.
        // Tanpa ini, PID yang sudah didaur ulang Windows bisa membuat kita
        // membersihkan - atau mengakhiri - proses yang sama sekali berbeda.
        private static Process ResolveVerified(ProcItem it, out string error)
        {
            error = null;
            Process p = null;
            try
            {
                p = Process.GetProcessById(it.Id);
            }
            catch
            {
                error = "Proses sudah tidak berjalan.";
                return null;
            }

            try
            {
                if (!string.Equals(p.ProcessName, it.Name, StringComparison.OrdinalIgnoreCase))
                {
                    error = "PID " + it.Id + " sekarang dipakai proses lain ('"
                        + p.ProcessName + "'). Dibatalkan.";
                    p.Dispose();
                    return null;
                }

                long ticks = SafeStartTicks(p);
                if (it.StartTicks != 0 && ticks != 0 && ticks != it.StartTicks)
                {
                    error = "PID " + it.Id + " sudah didaur ulang oleh proses baru. Dibatalkan.";
                    p.Dispose();
                    return null;
                }
            }
            catch (Exception ex)
            {
                error = ex.Message;
                try { p.Dispose(); } catch { }
                return null;
            }

            return p;
        }

        // ===================== Status helper =====================

        private static void SetStatusUi(string text)
        {
            _txtStatus.Text = text;
        }

        // Dipanggil dari thread pembersih.
        private static void Status(string text)
        {
            string captured = text;
            _window.Dispatcher.BeginInvoke(new Action(delegate { SetStatusUi(captured); }));
        }

        private static void SetBusy(bool busy)
        {
            _btnClean.IsEnabled = !busy;
            _btnRestartExplorer.IsEnabled = !busy;
            _btnRefresh.IsEnabled = !busy;
            if (busy && _procMenu != null) { _procMenu.IsOpen = false; }
        }

        // ===================== Pembersihan =====================

        private sealed class CleanOutcome
        {
            public bool Deep;
            public bool FromAuto;
            public int Rounds;
            public int DistinctProcesses;
            public bool PrivProfile;
            public bool PrivQuota;
            public bool StatusOk;
            public int PctBefore;
            public int PctAfter;
            public double FreedMb;
            public readonly Dictionary<string, string> Failures =
                new Dictionary<string, string>();
        }

        private static void Note(CleanOutcome o, string stage, string err)
        {
            if (err == null) { return; }
            // Kegagalan diakumulasi per tahap, bukan ditimpa tiap putaran.
            o.Failures[stage] = err;
        }

        private static void CleanRam(bool fromAuto)
        {
            if (_isCleaning) { return; }

            int threshold;
            if (fromAuto && !TryThreshold(out threshold)) { return; }

            _isCleaning = true;
            SetBusy(true);

            bool deep = _chkAggressive.IsChecked == true;

            // Cast eksplisit: anonymous method tanpa parameter bisa dikonversi ke
            // ThreadStart maupun ParameterizedThreadStart (CS0121 di csc lama).
            Thread worker = new Thread((ThreadStart)delegate { CleanWorker(deep, fromAuto); });
            worker.IsBackground = true;
            worker.Name = "RamCleanWorker";
            worker.Start();
        }

        // Berjalan di thread background. Seluruh P/Invoke di sini tidak butuh UI
        // thread, jadi jendela tetap responsif (dulu semuanya di UI thread dengan
        // Thread.Sleep + DoEvents manual).
        private static void CleanWorker(bool deep, bool fromAuto)
        {
            CleanOutcome o = new CleanOutcome();
            o.Deep = deep;
            o.FromAuto = fromAuto;

            try
            {
                Status("Menyiapkan hak istimewa sistem...");

                // Dua panggilan terpisah: dengan && yang kedua tidak pernah dicoba
                // kalau yang pertama gagal, padahal keduanya independen.
                o.PrivProfile = Privilege.Enable("SeProfileSingleProcessPrivilege");
                o.PrivQuota = Privilege.Enable("SeIncreaseQuotaPrivilege");
                if (!o.PrivProfile)
                {
                    Note(o, "SeProfileSingleProcessPrivilege", "tidak bisa diaktifkan");
                }
                if (!o.PrivQuota)
                {
                    Note(o, "SeIncreaseQuotaPrivilege", "tidak bisa diaktifkan");
                }

                MemApi.MEMORYSTATUSEX before;
                o.StatusOk = MemApi.TryGetStatus(out before);
                o.PctBefore = (int)before.dwMemoryLoad;

                string[] excl = deep ? ExcludedCritical : Excluded;
                int maxRounds = deep ? 6 : 2;
                HashSet<int> touched = new HashSet<int>();
                double prevAvailMb = -1;

                for (int r = 1; r <= maxRounds; r++)
                {
                    Status(string.Format(
                        deep
                            ? "Putaran {0}/{1}: membersihkan working set semua proses..."
                            : "Membersihkan ({0}/{1})...",
                        r, maxRounds));

                    SweepProcesses(excl, touched);
                    Thread.Sleep(deep ? 300 : 80);

                    if (deep)
                    {
                        // Mengosongkan system working set, termasuk file cache.
                        // Menggantikan SetSystemFileCacheSize yang lama: cara itu
                        // bisa meninggalkan batas cache terkunci di 0 sampai reboot
                        // bila proses restore gagal.
                        Note(o, "Empty working set sistem",
                            MemApi.RunCommand(MemApi.CmdEmptyWorkingSets));
                        Thread.Sleep(150);

                        // Halaman kotor ditulis ke disk lalu jadi standby, supaya
                        // purge standby di bawah benar-benar bisa melepasnya.
                        Note(o, "Flush modified page list",
                            MemApi.RunCommand(MemApi.CmdFlushModifiedList));
                        Thread.Sleep(150);
                    }

                    Note(o, "Purge standby prioritas rendah",
                        MemApi.RunCommand(MemApi.CmdPurgeLowPriorityStandbyList));
                    Thread.Sleep(120);
                    Note(o, "Purge standby list",
                        MemApi.RunCommand(MemApi.CmdPurgeStandbyList));
                    Thread.Sleep(deep ? 350 : 200);

                    o.Rounds = r;

                    MemApi.MEMORYSTATUSEX probe;
                    if (!MemApi.TryGetStatus(out probe)) { break; }

                    double availMb = probe.ullAvailPhys / 1048576.0;
                    if (prevAvailMb >= 0 && (availMb - prevAvailMb) < 30)
                    {
                        break;   // hasil sudah konvergen
                    }
                    prevAvailMb = availMb;
                }

                Status("Menutup: membersihkan working set aplikasi ini...");
                try { MemApi.EmptyWorkingSet(MemApi.GetCurrentProcess()); } catch { }

                Thread.Sleep(500);

                MemApi.MEMORYSTATUSEX after;
                if (MemApi.TryGetStatus(out after))
                {
                    o.PctAfter = (int)after.dwMemoryLoad;
                    long usedBefore = (long)(before.ullTotalPhys - before.ullAvailPhys);
                    long usedAfter = (long)(after.ullTotalPhys - after.ullAvailPhys);
                    double freed = (usedBefore - usedAfter) / 1048576.0;
                    o.FreedMb = freed < 0 ? 0 : freed;
                }
                else
                {
                    o.StatusOk = false;
                }

                o.DistinctProcesses = touched.Count;
            }
            catch (Exception ex)
            {
                Note(o, "Kesalahan tak terduga", ex.Message);
                Log.Write("CleanWorker gagal: " + ex);
            }

            CleanOutcome captured = o;
            _window.Dispatcher.BeginInvoke(new Action(delegate { FinishClean(captured); }));
        }

        private static void FinishClean(CleanOutcome o)
        {
            try
            {
                string modeText = o.Deep
                    ? "mode mendalam, " + o.Rounds + " putaran adaptif"
                    : "mode cepat, " + o.Rounds + " putaran";

                StringBuilder sb = new StringBuilder();
                if (o.FromAuto) { sb.Append("[AUTO] "); }

                // "DistinctProcesses" adalah jumlah PID unik, bukan akumulasi
                // per putaran (dulu 6 putaran x ~150 proses dilaporkan sebagai 900).
                sb.Append(string.Format(
                    "Selesai. {0} proses diproses ({1}).",
                    o.DistinctProcesses, modeText));

                if (o.StatusOk)
                {
                    sb.Append(string.Format(
                        "\nRAM tersedia naik sekitar {0:N0} MB ({1}% → {2}%).",
                        o.FreedMb, o.PctBefore, o.PctAfter));
                }
                else
                {
                    sb.Append("\nStatus memori tidak bisa dibaca, selisih tidak dihitung.");
                }

                if (o.Failures.Count > 0)
                {
                    List<string> parts = new List<string>();
                    foreach (KeyValuePair<string, string> kv in o.Failures)
                    {
                        parts.Add(kv.Key + " (" + kv.Value + ")");
                    }
                    sb.Append("\nTahap gagal: " + string.Join("; ", parts.ToArray()));
                }

                string msg = sb.ToString();
                SetStatusUi(msg);
                Log.Write(msg.Replace("\n", " | "));

                if (o.FromAuto && Tray.Active && !_window.IsVisible)
                {
                    Tray.Balloon("RAM Cleaner - auto bersih",
                        string.Format("{0}% → {1}%, sekitar {2:N0} MB dilepas.",
                            o.PctBefore, o.PctAfter, o.FreedMb));
                }

                UpdateDisplay();
            }
            finally
            {
                _lastCleanTicks = Environment.TickCount;
                _isCleaning = false;
                SetBusy(false);
            }
        }

        private static void SweepProcesses(string[] excluded, HashSet<int> touched)
        {
            Process[] procs = Process.GetProcesses();
            foreach (Process p in procs)
            {
                try
                {
                    if (p.Id == _ownPid) { continue; }
                    // ToLowerInvariant: ToLower() bergantung culture, dan di tr-TR
                    // "WININIT" jadi "wınınıt" sehingga daftar pengecualian bocor.
                    if (Array.IndexOf(excluded, p.ProcessName.ToLowerInvariant()) >= 0)
                    {
                        continue;
                    }
                    // Process.Handle melempar bila akses ditolak - itu jalur
                    // normal untuk proses terlindungi, bukan error yang perlu dicatat.
                    if (MemApi.EmptyWorkingSet(p.Handle))
                    {
                        touched.Add(p.Id);
                    }
                }
                catch { }
                finally
                {
                    try { p.Dispose(); } catch { }
                }
            }
        }

        // ===================== Auto clean =====================

        private static bool TryThreshold(out int value)
        {
            value = 0;
            if (_txtThreshold == null) { return false; }
            string raw = _txtThreshold.Text.Trim();
            if (!int.TryParse(raw, NumberStyles.Integer, CultureInfo.InvariantCulture, out value))
            {
                return false;
            }
            return value >= 50 && value <= 99;
        }

        private static void ValidateThreshold(bool announce)
        {
            int t;
            bool ok = TryThreshold(out t);
            _txtThreshold.BorderBrush = ok ? BrSurfaceHi : BrRed;
            _txtThreshold.ToolTip = ok ? null : "Masukkan angka bulat 50-99";

            // Dulu ambang tidak valid membuat auto-clean mati tanpa tanda apa pun.
            if (!ok && (announce || _chkAuto.IsChecked == true))
            {
                SetStatusUi("Ambang auto-clean tidak valid (harus 50-99). Auto-clean nonaktif.");
            }
        }

        private static void CheckAutoClean()
        {
            if (_isCleaning || _chkAuto.IsChecked != true) { return; }

            int t;
            if (!TryThreshold(out t)) { return; }
            if (_lastPct < t) { return; }

            // Environment.TickCount monotonik. DateTime.Now bisa melompat mundur
            // (DST, koreksi NTP, user ubah jam) dan mematikan auto-clean sampai
            // sepanjang lompatan itu.
            int elapsed = unchecked(Environment.TickCount - _lastCleanTicks);
            if (elapsed < 60000) { return; }

            CleanRam(true);
        }

        // ===================== Aksi per proses =====================

        private static void CleanSingle(ProcItem it)
        {
            if (it == null) { return; }
            // Guard yang dulu tidak ada: tanpa ini aksi ini bisa berjalan
            // bersamaan dengan CleanRam dan saling menimpa status.
            if (_isCleaning) { return; }

            string err;
            Process p = ResolveVerified(it, out err);
            if (p == null)
            {
                SetStatusUi(err);
                return;
            }

            long beforeWs = 0;
            bool ok = false;
            int wsError = 0;
            try
            {
                beforeWs = p.WorkingSet64;
                ok = MemApi.EmptyWorkingSet(p.Handle);
                if (!ok)
                {
                    // Ditangkap di sini: p.Dispose() di finally bisa menimpa
                    // last-error thread sebelum pesan disusun.
                    wsError = Marshal.GetLastWin32Error();
                }
            }
            catch (Exception ex)
            {
                SetStatusUi("Gagal membersihkan '" + it.Name + "': " + ex.Message);
                return;
            }
            finally
            {
                try { p.Dispose(); } catch { }
            }

            if (!ok)
            {
                SetStatusUi("Gagal membersihkan '" + it.Name + "' (error "
                    + wsError + ").");
                return;
            }

            double freed = 0;
            try
            {
                using (Process again = Process.GetProcessById(it.Id))
                {
                    freed = Math.Max(0, (beforeWs - again.WorkingSet64) / 1048576.0);
                }
            }
            catch { }

            UpdateDisplay();
            string msg = string.Format(
                "Proses '{0}' dibersihkan (sekitar {1:N0} MB dilepas).", it.Name, freed);
            SetStatusUi(msg);
            Log.Write(msg);
        }

        private static void KillSingle(ProcItem it)
        {
            if (it == null) { return; }
            if (_isCleaning) { return; }

            // Mengakhiri proses ini akan membuat Windows bluescreen atau logout paksa.
            if (Array.IndexOf(ExcludedCritical, it.Name.ToLowerInvariant()) >= 0)
            {
                SetStatusUi("'" + it.Name + "' adalah proses kritis Windows - "
                    + "mengakhirinya akan membuat sistem crash. Dibatalkan.");
                return;
            }

            MessageBoxResult r = MessageBox.Show(
                "Akhiri proses '" + it.Name + "' (PID " + it.Id + ")?\n\n" +
                "Data yang belum disimpan di aplikasi tersebut akan HILANG.\n" +
                "Proses tidak diberi kesempatan menyimpan apa pun.",
                "Akhiri Proses",
                MessageBoxButton.OKCancel, MessageBoxImage.Warning);
            if (r != MessageBoxResult.OK) { return; }

            // Diverifikasi ulang SETELAH dialog: selama dialog terbuka proses bisa
            // keluar dan PID-nya dipakai proses lain.
            string err;
            Process p = ResolveVerified(it, out err);
            if (p == null)
            {
                SetStatusUi(err);
                return;
            }

            try
            {
                p.Kill();
                p.WaitForExit(3000);
                string msg = "Proses '" + it.Name + "' (PID " + it.Id + ") diakhiri.";
                SetStatusUi(msg);
                Log.Write(msg);
            }
            catch (Exception ex)
            {
                SetStatusUi("Gagal mengakhiri '" + it.Name + "': " + ex.Message);
            }
            finally
            {
                try { p.Dispose(); } catch { }
            }

            UpdateDisplay();
        }

        // ===================== Log =====================

        private static void OpenLog()
        {
            string err = Log.Open();
            if (err != null)
            {
                SetStatusUi("Gagal membuka log: " + err);
            }
        }

        // ===================== Restart Explorer =====================

        private static void RestartExplorer()
        {
            if (_isCleaning) { return; }

            MessageBoxResult r = MessageBox.Show(
                "Restart Windows Explorer?\n\n" +
                "Taskbar & desktop hilang sebentar (2-5 detik).\n" +
                "Jendela File Explorer yang terbuka akan tertutup.\n" +
                "Aplikasi lain TIDAK terpengaruh.",
                "Restart Explorer",
                MessageBoxButton.OKCancel, MessageBoxImage.Question);
            if (r != MessageBoxResult.OK) { return; }

            _isCleaning = true;
            SetBusy(true);

            Thread worker = new Thread((ThreadStart)delegate { RestartExplorerWorker(); });
            worker.IsBackground = true;
            worker.Name = "RestartExplorerWorker";
            worker.Start();
        }

        private static void RestartExplorerWorker()
        {
            string result;
            try
            {
                Status("Mematikan explorer.exe...");
                KillExplorerInSession();

                // Windows biasanya menjalankan ulang shell sendiri (AutoRestartShell).
                // Tunggu sampai 6 detik sebelum turun ke jalur manual.
                Status("Menunggu Windows menjalankan ulang shell...");
                bool back = false;
                for (int i = 0; i < 12; i++)
                {
                    Thread.Sleep(500);
                    if (CountExplorerInSession() > 0) { back = true; break; }
                }

                if (!back)
                {
                    Status("Menjalankan ulang explorer.exe secara manual...");
                    string err = StartExplorer();
                    if (err != null)
                    {
                        result = "Gagal menjalankan ulang explorer: " + err
                            + "\nBuka manual: Ctrl+Shift+Esc > Run new task > explorer.exe";
                    }
                    else
                    {
                        Thread.Sleep(1200);
                        back = CountExplorerInSession() > 0;
                        result = back
                            ? "Explorer berhasil direstart. Memori shell kembali ke ukuran awal."
                            : "Explorer belum muncul. Buka manual: Ctrl+Shift+Esc > Run new task > explorer.exe";
                    }
                }
                else
                {
                    result = "Explorer berhasil direstart. Memori shell kembali ke ukuran awal.";
                }
            }
            catch (Exception ex)
            {
                result = "Terjadi kesalahan: " + ex.Message;
                Log.Write("RestartExplorer gagal: " + ex);
            }

            string captured = result;
            _window.Dispatcher.BeginInvoke(new Action(delegate
            {
                SetStatusUi(captured);
                Log.Write(captured.Replace("\n", " | "));
                UpdateDisplay();
                _isCleaning = false;
                SetBusy(false);
            }));
        }

        // Hanya shell di sesi kita. Process.GetProcessesByName cakupannya
        // seluruh mesin, jadi tanpa filter ini shell user lain (RDP / fast user
        // switching) juga ikut dimatikan.
        private static void KillExplorerInSession()
        {
            Process[] ps = Process.GetProcessesByName("explorer");
            foreach (Process p in ps)
            {
                try
                {
                    if (p.SessionId == _ownSessionId) { p.Kill(); }
                }
                catch { }
                finally
                {
                    try { p.Dispose(); } catch { }
                }
            }
        }

        private static int CountExplorerInSession()
        {
            int n = 0;
            Process[] ps = Process.GetProcessesByName("explorer");
            foreach (Process p in ps)
            {
                try
                {
                    if (p.SessionId == _ownSessionId) { n++; }
                }
                catch { }
                finally
                {
                    try { p.Dispose(); } catch { }
                }
            }
            return n;
        }

        private static string StartExplorer()
        {
            // explorer.exe ada di %WINDIR%, BUKAN di System32.
            string winDir = Environment.GetFolderPath(Environment.SpecialFolder.Windows);
            string exe = IOPath.Combine(winDir, "explorer.exe");
            try
            {
                Process p = Process.Start(new ProcessStartInfo
                {
                    FileName = File.Exists(exe) ? exe : "explorer.exe",
                    UseShellExecute = true
                });
                if (p != null) { p.Dispose(); }
                return null;
            }
            catch (Exception ex)
            {
                return ex.Message;
            }
        }
    }
}
