            _txtThreshold.Width = 34;
            _txtThreshold.FontSize = 11;
            _txtThreshold.Margin = new Thickness(4, 0, 2, 0);
            _txtThreshold.Padding = new Thickness(2, 1, 2, 1);
            _txtThreshold.VerticalAlignment = VerticalAlignment.Center;
            _txtThreshold.Background = BrSurface;
            _txtThreshold.Foreground = BrText;
            _txtThreshold.BorderBrush = BrSurfaceHi;
            _txtThreshold.BorderThickness = new Thickness(1);
            autoRow.Children.Add(_txtThreshold);

            TextBlock pctSuffix = new TextBlock();
            pctSuffix.Text = "%";
            pctSuffix.FontSize = 11;
            pctSuffix.Foreground = BrSubtext;
            pctSuffix.VerticalAlignment = VerticalAlignment.Center;
            autoRow.Children.Add(pctSuffix);

            csp.Children.Add(autoRow);

            Button btnLog = new Button();
            btnLog.Content = "Buka Log Pembersihan";
            btnLog.Height = 30;
            btnLog.Margin = new Thickness(2, 10, 0, 0);
            btnLog.FontSize = 11;
            btnLog.Style = ButtonStyle(BrSurface, BrSurfaceHi, BrText);
            btnLog.Click += delegate { OpenLog(); };
