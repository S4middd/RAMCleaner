// RAM Cleaner - utilitas pembersih memori untuk Windows.
//
// Build: jalankan build.bat (csc.exe .NET Framework, tanpa SDK).
// Bahasa: C# 5 (csc v4.0.30319) - hindari string interpolation, ?., nameof.
//
// Catatan jujur soal cara kerjanya: EmptyWorkingSet dan purge standby list TIDAK
// menghapus data dari RAM. Keduanya memindahkan halaman keluar dari working set
// proses ke standby list / pagefile. Angka "Available RAM naik" karena itu mengukur
// berapa banyak halaman yang dipindahkan, bukan keuntungan bersih: aplikasi yang
// halamannya diambil akan memuat ulang dari disk dan sesaat terasa lebih lambat.

using System;
using System.Collections.Generic;
using System.Collections.ObjectModel;
using System.ComponentModel;
using System.Diagnostics;
using System.Globalization;
using System.IO;
using System.Runtime.InteropServices;
using System.Security.Principal;
using System.Text;
using System.Threading;
using System.Windows;
using System.Windows.Controls;
using System.Windows.Data;
using System.Windows.Documents;
using System.Windows.Input;
using System.Windows.Interop;
using System.Windows.Media;
using System.Windows.Shapes;
using System.Windows.Threading;

// System.IO.Path bentrok dengan System.Windows.Shapes.Path (WPF).
using IOPath = System.IO.Path;

namespace RamCleaner
{
    internal static class MemApi
    {
        [StructLayout(LayoutKind.Sequential)]
        public struct MEMORYSTATUSEX
        {
            public uint dwLength;
            public uint dwMemoryLoad;
            public ulong ullTotalPhys;
            public ulong ullAvailPhys;
            public ulong ullTotalPageFile;
            public ulong ullAvailPageFile;
            public ulong ullTotalVirtual;
            public ulong ullAvailVirtual;
            public ulong ullAvailExtendedVirtual;
        }

        [StructLayout(LayoutKind.Sequential)]
        public struct PERFORMANCE_INFORMATION
        {
            public uint cb;
            public IntPtr CommitTotal;
            public IntPtr CommitLimit;
            public IntPtr CommitPeak;
            public IntPtr PhysicalTotal;
            public IntPtr PhysicalAvailable;
            public IntPtr SystemCache;
            public IntPtr KernelTotal;
            public IntPtr KernelPaged;
            public IntPtr KernelNonpaged;
            public IntPtr PageSize;
            public uint HandleCount;
            public uint ProcessCount;
            public uint ThreadCount;
        }

        public struct MemBreakdown
        {
            public ulong TotalBytes;
            public ulong InUseBytes;
            public ulong StandbyBytes;
            public ulong ModifiedBytes;
            public ulong FreeBytes;
            // true bila angka standby/free berasal dari SystemMemoryListInformation
            // (akurat). false bila hanya perkiraan dari GetPerformanceInfo.
            public bool Accurate;
        }

        [DllImport("psapi.dll", SetLastError = true)]
        public static extern bool GetPerformanceInfo(out PERFORMANCE_INFORMATION pPerformanceInformation, uint cb);

        [DllImport("psapi.dll", SetLastError = true)]
        public static extern bool EmptyWorkingSet(IntPtr hProcess);

        [DllImport("kernel32.dll", SetLastError = true)]
        public static extern bool GlobalMemoryStatusEx(ref MEMORYSTATUSEX lpBuffer);

        [DllImport("kernel32.dll")]
        public static extern IntPtr GetCurrentProcess();

        [DllImport("dwmapi.dll")]
        public static extern int DwmSetWindowAttribute(IntPtr hwnd, int attribute, ref int value, int size);

        [DllImport("ntdll.dll")]
        public static extern int NtSetSystemInformation(int infoClass, ref int info, int length);

        [DllImport("ntdll.dll")]
        public static extern int NtQuerySystemInformation(
            int infoClass, IntPtr buffer, int length, out int returnLength);

        public const int SystemMemoryListInformation = 80;

        // MEMORY_LIST_COMMAND - perintah yang masih didukung Windows modern.
        // Ini set yang sama dipakai RAMMap.
        public const int CmdEmptyWorkingSets = 2;            // termasuk system working set (file cache)
        public const int CmdFlushModifiedList = 3;           // tulis halaman kotor ke disk -> jadi standby
        public const int CmdPurgeStandbyList = 4;
        public const int CmdPurgeLowPriorityStandbyList = 5;

        private static readonly int SizeMemStatus = Marshal.SizeOf(typeof(MEMORYSTATUSEX));
        private static readonly int SizePerfInfo = Marshal.SizeOf(typeof(PERFORMANCE_INFORMATION));

        public static bool TryGetStatus(out MEMORYSTATUSEX s)
        {
            s = new MEMORYSTATUSEX();
            s.dwLength = (uint)SizeMemStatus;
            return GlobalMemoryStatusEx(ref s);
        }

        // SYSTEM_MEMORY_LIST_INFORMATION dibaca sebagai deretan ULONG_PTR supaya
        // otomatis benar di 32-bit maupun 64-bit:
        //   0 ZeroPageCount, 1 FreePageCount, 2 ModifiedPageCount,
        //   3 ModifiedNoWritePageCount, 4 BadPageCount,
        //   5..12 PageCountByPriority[8]  <- ini standby list
        //   13..20 RepurposedPagesByPriority[8], 21 ModifiedPageCountPageFile
        private const int MemListFieldCount = 22;

        public static bool TryGetMemoryList(
            out ulong standbyPages, out ulong freePages, out ulong modifiedPages)
        {
            standbyPages = 0;
            freePages = 0;
            modifiedPages = 0;

            int slot = IntPtr.Size;
            IntPtr buf = IntPtr.Zero;
            try
            {
                buf = Marshal.AllocHGlobal(slot * MemListFieldCount);
                int written;
                int st = NtQuerySystemInformation(
                    SystemMemoryListInformation, buf, slot * MemListFieldCount, out written);
                if (st != 0)
                {
                    return false;
                }

                ulong zero = (ulong)Marshal.ReadIntPtr(buf, 0 * slot).ToInt64();
                ulong free = (ulong)Marshal.ReadIntPtr(buf, 1 * slot).ToInt64();
                modifiedPages = (ulong)Marshal.ReadIntPtr(buf, 2 * slot).ToInt64();

                ulong standby = 0;
                for (int i = 0; i < 8; i++)
                {
                    standby += (ulong)Marshal.ReadIntPtr(buf, (5 + i) * slot).ToInt64();
                }

                standbyPages = standby;
                freePages = zero + free;
                return true;
            }
            catch
            {
                return false;
            }
            finally
            {
                if (buf != IntPtr.Zero) { Marshal.FreeHGlobal(buf); }
            }
        }

        public static MemBreakdown GetBreakdown()
        {
            MemBreakdown b = new MemBreakdown();

            PERFORMANCE_INFORMATION pi;
            pi.cb = (uint)SizePerfInfo;
            if (!GetPerformanceInfo(out pi, pi.cb))
            {
                return b;
            }

            long pageSize = pi.PageSize.ToInt64();
            if (pageSize <= 0) { pageSize = 4096; }

            ulong total = (ulong)(pi.PhysicalTotal.ToInt64() * pageSize);
            ulong avail = (ulong)(pi.PhysicalAvailable.ToInt64() * pageSize);
            b.TotalBytes = total;

            ulong standbyPages, freePages, modifiedPages;
            if (TryGetMemoryList(out standbyPages, out freePages, out modifiedPages))
            {
                b.StandbyBytes = standbyPages * (ulong)pageSize;
                b.FreeBytes = freePages * (ulong)pageSize;
                b.ModifiedBytes = modifiedPages * (ulong)pageSize;

                ulong notInUse = b.StandbyBytes + b.FreeBytes;
                b.InUseBytes = total > notInUse ? total - notInUse : 0;
                b.Accurate = true;
                return b;
            }

            // Fallback perkiraan. Available sudah mencakup standby, dan
            // pi.SystemCache adalah system cache working set (BUKAN ukuran standby
            // list), jadi standby tidak bisa dipisahkan di jalur ini.
            b.InUseBytes = total > avail ? total - avail : 0;
            b.StandbyBytes = 0;
            b.FreeBytes = avail;
            b.Accurate = false;
            return b;
        }

        // Mengembalikan null bila sukses, atau deskripsi error bila gagal.
        public static string RunCommand(int command)
        {
            try
            {
                int cmd = command;
                int st = NtSetSystemInformation(SystemMemoryListInformation, ref cmd, 4);
                if (st == 0)
                {
                    return null;
                }
                if (st == unchecked((int)0xC0000061))
                {
                    return "hak istimewa tidak dimiliki (0xC0000061)";
                }
                if (st == unchecked((int)0xC0000002))
                {
                    return "tidak didukung Windows ini (0xC0000002)";
                }
                return "NTSTATUS 0x" + st.ToString("X8");
            }
            catch (Exception ex)
            {
                return ex.Message;
            }
        }
    }

    internal static class Privilege
    {
        [StructLayout(LayoutKind.Sequential)]
        public struct LUID
        {
            public uint LowPart;
            public int HighPart;
        }

        [StructLayout(LayoutKind.Sequential)]
        public struct TOKEN_PRIVILEGES
        {
            public int PrivilegeCount;
            public LUID Luid;
            public int Attributes;
        }

        private const uint TOKEN_ADJUST_PRIVILEGES = 0x20;
        private const uint TOKEN_QUERY = 0x8;
        private const int SE_PRIVILEGE_ENABLED = 0x2;

        [DllImport("advapi32.dll", SetLastError = true, CharSet = CharSet.Unicode)]
        private static extern bool LookupPrivilegeValue(string systemName, string name, out LUID luid);

        [DllImport("advapi32.dll", SetLastError = true)]
        private static extern bool OpenProcessToken(IntPtr processHandle, uint desiredAccess, out IntPtr tokenHandle);

        [DllImport("advapi32.dll", SetLastError = true)]
        private static extern bool AdjustTokenPrivileges(
            IntPtr tokenHandle, bool disableAllPrivileges,
            ref TOKEN_PRIVILEGES newState, int bufferLength,
            IntPtr previousState, IntPtr returnLength);

        [DllImport("kernel32.dll", SetLastError = true)]
        private static extern bool CloseHandle(IntPtr handle);

        public static bool Enable(string privilegeName)
        {
            IntPtr token = IntPtr.Zero;
            try
            {
                // Pseudo-handle kernel32 (-1): tidak perlu ditutup, dan tidak
                // membocorkan Process object seperti Process.GetCurrentProcess().Handle.
                if (!OpenProcessToken(MemApi.GetCurrentProcess(),
                    TOKEN_ADJUST_PRIVILEGES | TOKEN_QUERY, out token))
                {
                    return false;
                }

                LUID luid;
                if (!LookupPrivilegeValue(null, privilegeName, out luid))
                {
                    return false;
                }

                TOKEN_PRIVILEGES tp = new TOKEN_PRIVILEGES();
                tp.PrivilegeCount = 1;
                tp.Luid = luid;
                tp.Attributes = SE_PRIVILEGE_ENABLED;

                bool ok = AdjustTokenPrivileges(token, false, ref tp, 0, IntPtr.Zero, IntPtr.Zero);
                // AdjustTokenPrivileges tetap TRUE walau privilege tidak dimiliki;
                // ERROR_NOT_ALL_ASSIGNED (1300) yang menandakan kegagalan sebenarnya.
                int err = Marshal.GetLastWin32Error();
                return ok && err == 0;
            }
            catch
            {
                return false;
            }
            finally
            {
                if (token != IntPtr.Zero) { CloseHandle(token); }
            }
        }
    }

    public class ProcItem : INotifyPropertyChanged
    {
        private string _name;
        private int _id;
        private double _memMb;

        public string Name
        {
            get { return _name; }
            set { if (_name != value) { _name = value; Raise("Name"); } }
        }

        public int Id
        {
            get { return _id; }
            set { if (_id != value) { _id = value; Raise("Id"); } }
        }

        public double MemMB
        {
            get { return _memMb; }
            set { if (_memMb != value) { _memMb = value; Raise("MemMB"); } }
        }

        // Dipakai untuk memastikan PID belum didaur ulang oleh proses lain
        // sebelum kita membersihkan / mengakhiri proses. 0 = tidak diketahui.
        public long StartTicks { get; set; }

        public event PropertyChangedEventHandler PropertyChanged;

        private void Raise(string prop)
        {
            PropertyChangedEventHandler h = PropertyChanged;
            if (h != null) { h(this, new PropertyChangedEventArgs(prop)); }
        }
    }

    internal static class Log
    {
        private static readonly object Gate = new object();
        private static string _path;
        private static bool _resolved;

        // Dihitung lazy, BUKAN di static initializer: kalau ini throw di dalam
        // type initializer, app mati tanpa dialog karena berjalan sebelum
        // try/catch di Main.
        public static string FilePath
        {
            get
            {
                lock (Gate)
                {
                    if (!_resolved)
                    {
                        _resolved = true;
                        _path = Resolve();
                    }
                    return _path;
                }
            }
        }

        private static string Resolve()
        {
            try
            {
                string exe = System.Reflection.Assembly.GetExecutingAssembly().Location;
                if (!string.IsNullOrEmpty(exe))
                {
                    string dir = IOPath.GetDirectoryName(exe);
                    if (!string.IsNullOrEmpty(dir))
                    {
                        return IOPath.Combine(dir, "RAMCleaner_history.log");
                    }
                }
            }
            catch { }

            try
            {
                string local = IOPath.Combine(
                    Environment.GetFolderPath(Environment.SpecialFolder.LocalApplicationData),
                    "RAMCleaner");
                Directory.CreateDirectory(local);
                return IOPath.Combine(local, "RAMCleaner_history.log");
            }
            catch { }

            return null;
        }

        public static void Write(string line)
        {
            string path = FilePath;
            if (string.IsNullOrEmpty(path)) { return; }
            try
            {
                string stamp = DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss");
                lock (Gate)
                {
                    File.AppendAllText(path, stamp + "  " + line + Environment.NewLine, Encoding.UTF8);
                }
            }
            catch { /* log gagal tidak boleh menjatuhkan app */ }
        }

        // Mengembalikan null bila sukses, atau pesan error.
        public static string Open()
        {
            string path = FilePath;
            if (string.IsNullOrEmpty(path))
            {
                return "Lokasi file log tidak bisa ditentukan.";
            }
            try
            {
                if (!File.Exists(path))
                {
                    File.WriteAllText(path,
                        "# Riwayat pembersihan RAM Cleaner" + Environment.NewLine +
                        "# Belum ada pembersihan yang tercatat." + Environment.NewLine,
                        Encoding.UTF8);
                }
                Process p = Process.Start(new ProcessStartInfo
                {
                    FileName = path,
                    UseShellExecute = true
                });
                if (p != null) { p.Dispose(); }
                return null;
            }
            catch (Exception ex)
            {
                return ex.Message;
            }
        }
    }

    // NotifyIcon dari WinForms. Tipe WinForms selalu ditulis lengkap supaya tidak
    // bentrok dengan tipe WPF bernama sama (ContextMenu, Application, MessageBox).
    internal static class Tray
    {
        private static System.Windows.Forms.NotifyIcon _ni;
        private static bool _hintShown;

        public static bool Active { get { return _ni != null; } }

        public static void Init()
        {
            try
            {
                _ni = new System.Windows.Forms.NotifyIcon();
                _ni.Icon = LoadIcon();
                _ni.Text = "RAM Cleaner";
                _ni.Visible = true;

                System.Windows.Forms.ContextMenuStrip menu = new System.Windows.Forms.ContextMenuStrip();
                menu.Items.Add("Tampilkan jendela", null, delegate { Program.ShowFromTray(); });
                menu.Items.Add("Bersihkan RAM sekarang", null, delegate { Program.CleanFromTray(); });
                menu.Items.Add(new System.Windows.Forms.ToolStripSeparator());
                menu.Items.Add("Keluar", null, delegate { Program.ExitApp(); });
                _ni.ContextMenuStrip = menu;

                _ni.DoubleClick += delegate { Program.ShowFromTray(); };
            }
            catch (Exception ex)
            {
                Log.Write("Tray gagal diinisialisasi: " + ex.Message);
                _ni = null;
            }
        }

        private static System.Drawing.Icon LoadIcon()
        {
            try
            {
                string exe = System.Reflection.Assembly.GetExecutingAssembly().Location;
                if (!string.IsNullOrEmpty(exe))
                {
                    System.Drawing.Icon ic = System.Drawing.Icon.ExtractAssociatedIcon(exe);
                    if (ic != null) { return ic; }
                }
            }
            catch { }
            return System.Drawing.SystemIcons.Application;
        }

        public static void SetTooltip(string text)
        {
            if (_ni == null) { return; }
            try
            {
                // NotifyIcon.Text dibatasi 63 karakter.
                if (text != null && text.Length > 63) { text = text.Substring(0, 63); }
                _ni.Text = text;
            }
            catch { }
        }

        public static void Balloon(string title, string body)
        {
            if (_ni == null) { return; }
            try
            {
                _ni.ShowBalloonTip(4000, title, body, System.Windows.Forms.ToolTipIcon.Info);
            }
            catch { }
        }

        public static void MinimizeHint()
        {
            if (_hintShown) { return; }
            _hintShown = true;
            Balloon("RAM Cleaner", "Masih berjalan di tray. Klik dua kali ikonnya untuk membuka lagi.");
        }

        public static void Dispose()
        {
            if (_ni == null) { return; }
            try
            {
                _ni.Visible = false;
                _ni.Dispose();
            }
            catch { }
            _ni = null;
        }
    }

    internal static class Program
    {
        private static readonly Color ColBg = Color.FromRgb(0x1E, 0x1E, 0x2E);
        private static readonly Color ColPanel = Color.FromRgb(0x18, 0x18, 0x25);
        private static readonly Color ColSurface = Color.FromRgb(0x31, 0x32, 0x44);
        private static readonly Color ColSurfaceHi = Color.FromRgb(0x45, 0x47, 0x5A);
        private static readonly Color ColText = Color.FromRgb(0xCD, 0xD6, 0xF4);
        private static readonly Color ColSubtext = Color.FromRgb(0xA6, 0xAD, 0xC8);
        private static readonly Color ColMuted = Color.FromRgb(0x6C, 0x70, 0x86);
        private static readonly Color ColBlue = Color.FromRgb(0x89, 0xB4, 0xFA);
        private static readonly Color ColBlueHi = Color.FromRgb(0xB4, 0xBE, 0xFE);
        private static readonly Color ColGreen = Color.FromRgb(0xA6, 0xE3, 0xA1);
        private static readonly Color ColYellow = Color.FromRgb(0xF9, 0xE2, 0xAF);
        private static readonly Color ColRed = Color.FromRgb(0xF3, 0x8B, 0xA8);
        private static readonly Color ColTeal = Color.FromRgb(0x94, 0xE2, 0xD5);

        // Brush di-cache: sebelumnya setiap UpdateDisplay (tiap 2 detik) membuat
        // SolidColorBrush baru.
        private static readonly Brush BrBg = Solid(ColBg);
        private static readonly Brush BrPanel = Solid(ColPanel);
        private static readonly Brush BrSurface = Solid(ColSurface);
        private static readonly Brush BrSurfaceHi = Solid(ColSurfaceHi);
        private static readonly Brush BrText = Solid(ColText);
        private static readonly Brush BrSubtext = Solid(ColSubtext);
        private static readonly Brush BrMuted = Solid(ColMuted);
        private static readonly Brush BrBlue = Solid(ColBlue);
        private static readonly Brush BrBlueHi = Solid(ColBlueHi);
        private static readonly Brush BrGreen = Solid(ColGreen);
        private static readonly Brush BrYellow = Solid(ColYellow);
        private static readonly Brush BrRed = Solid(ColRed);
        private static readonly Brush BrTeal = Solid(ColTeal);

        private static Window _window;
        private static Application _app;
        private static Mutex _singleInstance;

        private static TextBlock _txtUsage;
        private static Grid _meter;
        private static Border _barFill;
        private static TextBlock _txtDetail;
        private static Button _btnClean;
        private static Button _btnRestartExplorer;
        private static Button _btnRefresh;
        private static CheckBox _chkAggressive;
        private static TextBlock _txtStatus;
        private static ListView _lvProcs;
        private static DispatcherTimer _timer;
        private static int _lastPct;
        private static CheckBox _chkAuto;
        private static TextBox _txtThreshold;
        private static volatile bool _isCleaning;
        private static int _lastCleanTicks;
        private static Grid _stack;
        private static Border _barInUse;
        private static Border _barStandby;
        private static Border _barFree;
        private static TextBlock _txtBreakdown;
        private static double _lastInUseFrac;
        private static double _lastStandbyFrac;
        private static ContextMenu _procMenu;
        private static bool _menuOpen;
        private static int _tickCounter;

        private static Canvas _histCanvas;
        private static Polyline _histLine;
        private static Polygon _histFill;
        private static Line _histGridMid;
        private static Line _histGridHigh;
        private static readonly List<int> _history = new List<int>();
        private const int HistoryMax = 120;   // 120 x 2 detik = 4 menit

        private static readonly ObservableCollection<ProcItem> _procs =
            new ObservableCollection<ProcItem>();

        private static int _ownPid;
        private static int _ownSessionId;

        private static readonly string[] Excluded = new string[]
        {
            "system", "idle", "registry", "memory compression", "secure system",
            "memcompression", "smss", "csrss", "wininit", "winlogon",
            "services", "lsass", "svchost", "dwm", "fontdrvhost",
            "sihost", "explorer", "conhost", "wudfhost"
        };

        // Mode mendalam: hanya proses yang benar-benar kritis dilewati.
        // svchost, dwm, explorer, dll. ikut dibersihkan seperti RAMMap.
        private static readonly string[] ExcludedCritical = new string[]
        {
            "system", "idle", "registry", "memory compression", "secure system",
            "memcompression", "smss", "csrss", "wininit", "winlogon",
            "services", "lsass"
        };

        [STAThread]
        public static void Main()
        {
            try
            {
                bool created;
                _singleInstance = new Mutex(true, "Local\\RAMCleaner_SingleInstance", out created);
                if (!created)
                {
                    MessageBox.Show(
                        "RAM Cleaner sudah berjalan.\nCek ikonnya di system tray.",
                        "RAM Cleaner", MessageBoxButton.OK, MessageBoxImage.Information);
                    return;
                }
            }
            catch
            {
                // Mutex gagal dibuat bukan alasan untuk membatalkan start.
                _singleInstance = null;
            }

            try
            {
                System.Windows.Forms.Application.EnableVisualStyles();
            }
            catch { }

            try
            {
                RunApp();
            }
            catch (Exception ex)
            {
                Log.Write("FATAL: " + ex);
                MessageBox.Show(ex.ToString(), "RAM Cleaner - Error",
                    MessageBoxButton.OK, MessageBoxImage.Error);
            }
            finally
            {
                Tray.Dispose();
                ReleaseInstanceLock();
            }
        }

        private static void ReleaseInstanceLock()
        {
            if (_singleInstance == null) { return; }
            try { _singleInstance.ReleaseMutex(); } catch { }
            try { _singleInstance.Dispose(); } catch { }
            _singleInstance = null;
        }

        // Saat jendela tersembunyi di tray, monitoring dilambatkan: tidak ada
        // yang melihat grafik/daftar, dan auto-clean tetap jalan walau 5 detik.
        private static void SetTimerSlow(bool slow)
        {
            if (_timer == null) { return; }
            _timer.Interval = TimeSpan.FromSeconds(slow ? 5 : 2);
        }

        private static void TrimOwnWorkingSet()
        {
            // GC dulu supaya halaman heap yang bebas ikut terlepas, baru
            // EmptyWorkingSet mendorong sisanya ke standby list.
            try
            {
                GC.Collect();
                GC.WaitForPendingFinalizers();
            }
            catch { }
            try { MemApi.EmptyWorkingSet(MemApi.GetCurrentProcess()); } catch { }
        }

        private static void RunApp()
        {
            CacheOwnIdentity();

            _lastCleanTicks = Environment.TickCount - 600000;

            _app = new Application();
            _app.ShutdownMode = ShutdownMode.OnExplicitShutdown;
            _app.Exit += delegate { Tray.Dispose(); };

            _window = BuildWindow();
            WireEvents();

            _window.SourceInitialized += delegate
            {
                HwndSource src = (HwndSource)PresentationSource.FromVisual(_window);
                if (src != null)
                {
                    int on = 1;
                    // DWMWA_USE_IMMERSIVE_DARK_MODE: 20 di Windows 10 2004+, 19 sebelumnya.
                    if (MemApi.DwmSetWindowAttribute(src.Handle, 20, ref on, 4) != 0)
                    {
                        MemApi.DwmSetWindowAttribute(src.Handle, 19, ref on, 4);
                    }
                }
            };

            _window.StateChanged += delegate
            {
                if (_window.WindowState == WindowState.Minimized && Tray.Active)
                {
                    _window.Hide();
                    SetTimerSlow(true);
                    TrimOwnWorkingSet();
                    Tray.MinimizeHint();
                }
            };

            // Menutup jendela = keluar aplikasi (ShutdownMode OnExplicitShutdown
            // berarti kita harus shutdown sendiri).
            _window.Closed += delegate { ExitApp(); };

            Tray.Init();

            // Manifest sudah requireAdministrator, jadi normalnya cabang ini tidak
            // terpakai. Tetap disimpan untuk build tanpa manifest.
            if (!IsAdmin())
            {
                _txtStatus.Text = "Berjalan tanpa hak Admin - pembersihan tidak akan menyeluruh.";
            }

            _window.Show();
            UpdateDisplay();

            // Setelah render pertama, buang halaman startup yang tidak dipakai.
            _window.Dispatcher.BeginInvoke(
                DispatcherPriority.ApplicationIdle,
                new Action(TrimOwnWorkingSet));

            _timer = new DispatcherTimer();
            _timer.Interval = TimeSpan.FromSeconds(2);
            _timer.Tick += delegate { OnTick(); };
            _timer.Start();

            _app.Run();
        }

        private static void CacheOwnIdentity()
        {
            try
            {
                using (Process me = Process.GetCurrentProcess())
                {
                    _ownPid = me.Id;
                    _ownSessionId = me.SessionId;
                }
            }
            catch
            {
                _ownPid = 0;
                _ownSessionId = -1;
            }
        }

        private static bool IsAdmin()
        {
            try
            {
                return new WindowsPrincipal(WindowsIdentity.GetCurrent())
                    .IsInRole(WindowsBuiltInRole.Administrator);
            }
            catch
            {
                return false;
            }
        }

        internal static void ExitApp()
        {
            Tray.Dispose();
            if (_timer != null) { _timer.Stop(); }
            ReleaseInstanceLock();
            try { _app.Shutdown(); } catch { }
        }

        internal static void ShowFromTray()
        {
            if (_window == null) { return; }
            _window.Dispatcher.BeginInvoke(new Action(delegate
            {
                _window.Show();
                _window.WindowState = WindowState.Normal;
                SetTimerSlow(false);
                _window.Activate();
                _window.Topmost = true;
                _window.Topmost = false;
            }));
        }

        internal static void CleanFromTray()
        {
            if (_window == null) { return; }
            _window.Dispatcher.BeginInvoke(new Action(delegate { CleanRam(false); }));
        }

        // ===================== UI =====================

        private static Border MakeCard(Thickness margin)
        {
            Border b = new Border();
            b.Background = BrPanel;
            b.CornerRadius = new CornerRadius(10);
            b.Padding = new Thickness(16);
            b.Margin = margin;
            return b;
        }

        private static void CardLabel(Panel sp, string text, Brush color)
        {
            TextBlock t = new TextBlock();
            t.Text = text;
            t.FontSize = 12;
            t.FontWeight = FontWeights.Bold;
            t.Foreground = color;
            sp.Children.Add(t);
        }

        private static Window BuildWindow()
        {
            Window w = new Window();
            w.Title = "RAM Cleaner";
            w.Width = 1120;
            w.Height = 660;
            w.MinWidth = 900;
            w.MinHeight = 560;
            w.WindowStartupLocation = WindowStartupLocation.CenterScreen;
            w.ResizeMode = ResizeMode.CanResize;
            w.Background = BrBg;
            w.FontFamily = new FontFamily("Segoe UI");

            Grid root = new Grid();
            root.Margin = new Thickness(18);
            AddRow(root, GridLength.Auto);
            AddRow(root, GridLength.Auto);
            AddRow(root, new GridLength(1, GridUnitType.Star));
            w.Content = root;

            TextBlock title = new TextBlock();
            title.Text = "RAM CLEANER";
            title.FontSize = 14;
            title.FontWeight = FontWeights.Bold;
            title.Foreground = BrBlue;
            Grid.SetRow(title, 0);
            root.Children.Add(title);

            TextBlock subtitle = new TextBlock();
            subtitle.Text = "Pembersih memori - mode cepat & mendalam";
            subtitle.FontSize = 11;
            subtitle.Foreground = BrSubtext;
            subtitle.Margin = new Thickness(0, 2, 0, 12);
            Grid.SetRow(subtitle, 1);
            root.Children.Add(subtitle);

            Grid content = new Grid();
            AddColumn(content, new GridLength(0.95, GridUnitType.Star));
            AddColumn(content, new GridLength(1.05, GridUnitType.Star));
            AddColumn(content, new GridLength(1.55, GridUnitType.Star));
            Grid.SetRow(content, 2);
            root.Children.Add(content);

            content.Children.Add(BuildUsageCard());
            content.Children.Add(BuildControlCard());
            content.Children.Add(BuildProcessCard());

            return w;
        }

        private static void AddRow(Grid g, GridLength h)
        {
            RowDefinition r = new RowDefinition();
            r.Height = h;
            g.RowDefinitions.Add(r);
        }

        private static void AddColumn(Grid g, GridLength wd)
        {
            ColumnDefinition c = new ColumnDefinition();
            c.Width = wd;
            g.ColumnDefinitions.Add(c);
        }

        private static UIElement BuildUsageCard()
        {
            Border card = MakeCard(new Thickness(0, 0, 10, 0));
            StackPanel usp = new StackPanel();
            card.Child = usp;
            Grid.SetColumn(card, 0);

            CardLabel(usp, "PENGGUNAAN RAM", BrBlue);

            _txtUsage = new TextBlock();
            _txtUsage.Text = "-";
            _txtUsage.FontSize = 58;
            _txtUsage.FontWeight = FontWeights.Bold;
            _txtUsage.Foreground = BrGreen;
            _txtUsage.HorizontalAlignment = HorizontalAlignment.Center;
            _txtUsage.Margin = new Thickness(0, 6, 0, 0);
            usp.Children.Add(_txtUsage);

            Grid meter = new Grid();
            meter.Height = 14;
            meter.Margin = new Thickness(0, 10, 0, 0);

            Border track = new Border();
            track.CornerRadius = new CornerRadius(7);
            track.Background = BrSurface;
            meter.Children.Add(track);

            _barFill = new Border();
            _barFill.CornerRadius = new CornerRadius(7);
            _barFill.HorizontalAlignment = HorizontalAlignment.Left;
            _barFill.Margin = new Thickness(1);
            _barFill.Background = BrGreen;
            meter.Children.Add(_barFill);

            _meter = meter;
            meter.SizeChanged += delegate { RefreshFillWidth(); };
            usp.Children.Add(meter);

            _txtDetail = new TextBlock();
            _txtDetail.FontSize = 12;
            _txtDetail.Foreground = BrSubtext;
            _txtDetail.HorizontalAlignment = HorizontalAlignment.Center;
            _txtDetail.TextAlignment = TextAlignment.Center;
            _txtDetail.TextWrapping = TextWrapping.Wrap;
            _txtDetail.Margin = new Thickness(0, 10, 0, 0);
            usp.Children.Add(_txtDetail);

            Grid stack = new Grid();
            stack.Height = 10;
            stack.Margin = new Thickness(0, 12, 0, 0);

            Border stackTrack = new Border();
            stackTrack.CornerRadius = new CornerRadius(5);
            stackTrack.Background = BrSurface;
            stack.Children.Add(stackTrack);

            AddColumn(stack, new GridLength(0, GridUnitType.Star));
            AddColumn(stack, new GridLength(0, GridUnitType.Star));
            AddColumn(stack, new GridLength(1, GridUnitType.Star));

            _barInUse = new Border();
            _barInUse.CornerRadius = new CornerRadius(5, 0, 0, 5);
            _barInUse.Margin = new Thickness(1, 1, 0, 1);
            _barInUse.Background = BrGreen;
            Grid.SetColumn(_barInUse, 0);
            stack.Children.Add(_barInUse);

            _barStandby = new Border();
            _barStandby.Margin = new Thickness(0, 1, 0, 1);
            _barStandby.Background = BrBlue;
            Grid.SetColumn(_barStandby, 1);
            stack.Children.Add(_barStandby);

            _barFree = new Border();
            _barFree.CornerRadius = new CornerRadius(0, 5, 5, 0);
            _barFree.Margin = new Thickness(0, 1, 1, 1);
            _barFree.Background = BrMuted;
            Grid.SetColumn(_barFree, 2);
            stack.Children.Add(_barFree);

            _stack = stack;
            stack.SizeChanged += delegate { RefreshStackWidths(); };
            usp.Children.Add(stack);

            _txtBreakdown = new TextBlock();
            _txtBreakdown.FontSize = 11;
            _txtBreakdown.HorizontalAlignment = HorizontalAlignment.Center;
            _txtBreakdown.TextAlignment = TextAlignment.Center;
            _txtBreakdown.TextWrapping = TextWrapping.Wrap;
            _txtBreakdown.Margin = new Thickness(0, 8, 0, 0);
            usp.Children.Add(_txtBreakdown);

            TextBlock histLabel = new TextBlock();
            histLabel.Text = "RIWAYAT 4 MENIT";
            histLabel.FontSize = 10;
            histLabel.FontWeight = FontWeights.Bold;
            histLabel.Foreground = BrMuted;
            histLabel.Margin = new Thickness(0, 16, 0, 6);
            usp.Children.Add(histLabel);

            usp.Children.Add(BuildHistoryChart());

            return card;
        }

        private static UIElement BuildHistoryChart()
        {
            Border frame = new Border();
            frame.Background = BrBg;
            frame.CornerRadius = new CornerRadius(6);
            frame.Height = 62;
            frame.Padding = new Thickness(1);

            Canvas cv = new Canvas();
            cv.ClipToBounds = true;
            frame.Child = cv;
            _histCanvas = cv;

            _histGridMid = new Line();
            _histGridMid.Stroke = BrSurface;
            _histGridMid.StrokeThickness = 1;
            _histGridMid.StrokeDashArray = new DoubleCollection(new double[] { 3, 3 });
            cv.Children.Add(_histGridMid);

            _histGridHigh = new Line();
            _histGridHigh.Stroke = BrSurface;
            _histGridHigh.StrokeThickness = 1;
            _histGridHigh.StrokeDashArray = new DoubleCollection(new double[] { 3, 3 });
            cv.Children.Add(_histGridHigh);

            LinearGradientBrush grad = new LinearGradientBrush();
            grad.StartPoint = new Point(0, 0);
            grad.EndPoint = new Point(0, 1);
            grad.GradientStops.Add(new GradientStop(Color.FromArgb(0x66, 0x89, 0xB4, 0xFA), 0));
            grad.GradientStops.Add(new GradientStop(Color.FromArgb(0x00, 0x89, 0xB4, 0xFA), 1));
            grad.Freeze();

            _histFill = new Polygon();
            _histFill.Fill = grad;
            cv.Children.Add(_histFill);

            _histLine = new Polyline();
            _histLine.Stroke = BrBlue;
            _histLine.StrokeThickness = 1.6;
            _histLine.StrokeLineJoin = PenLineJoin.Round;
            cv.Children.Add(_histLine);

            cv.SizeChanged += delegate { RedrawHistory(); };
            return frame;
        }

