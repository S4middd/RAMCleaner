            MenuItem miKill = new MenuItem();
            miKill.Header = "Akhiri proses ini";
            miKill.Click += delegate { KillSingle(cm.Tag as ProcItem); };
            cm.Items.Add(miKill);
            cm.Opened += delegate
            {
                ProcItem sel = _lvProcs.SelectedItem as ProcItem;
                cm.Tag = sel;
                miClean.IsEnabled = sel != null;
                miKill.IsEnabled = sel != null;
                miClean.Header = sel != null
                    ? "Bersihkan '" + sel.Name + "'"
                    : "Bersihkan proses ini";
                miKill.Header = sel != null
                    ? "Akhiri '" + sel.Name + "'"
                    : "Akhiri proses ini";
            };
            lv.ContextMenu = cm;

            lv.PreviewMouseRightButtonDown += delegate(object sender, MouseButtonEventArgs args)
            {
                DependencyObject src = args.OriginalSource as DependencyObject;
                if (src == null) { return; }
                ListViewItem container =
                    ItemsControl.ContainerFromElement(lv, src) as ListViewItem;
                if (container != null)
                {
                    container.IsSelected = true;
                }
            };

            _lvProcs = lv;
            pg.Children.Add(lv);

            return w;
        }

        private static void WireEvents()
        {
            _btnClean.Click += delegate { CleanRam(false); };
            _btnRestartExplorer.Click += delegate { RestartExplorer(); };
        }

        private static void RestartExplorer()
        {
            if (_isCleaning) { return; }

            MessageBoxResult r = MessageBox.Show(
                "Restart Windows Explorer?\n\n" +
                "Taskbar & desktop hilang sebentar (2-5 detik).\n" +
                "Jendela File Explorer yang terbuka akan tertutup.\n" +
                "Aplikasi lain TIDAK terpengaruh.",
                "Restart Explorer",
                MessageBoxButton.OKCancel, MessageBoxImage.Question);
            if (r != MessageBoxResult.OK) { return; }

            _isCleaning = true;
            _btnClean.IsEnabled = false;
            try
            {
                SetStatus("Mematikan explorer.exe...");

                foreach (Process p in Process.GetProcessesByName("explorer"))
                {
                    try { p.Kill(); } catch { }
                    finally
                    {
                        try { p.Dispose(); } catch { }
                    }
                }

                System.Threading.Thread.Sleep(1500);

                // Windows biasanya me-restart otomatis (AutoRestartShell).
                // Kalau belum, jalankan manual.
                if (Process.GetProcessesByName("explorer").Length == 0)
                {
                    SetStatus("Menjalankan ulang explorer.exe...");
                    Process.Start(new ProcessStartInfo
                    {
                        FileName = System.Environment.SystemDirectory + "\\explorer.exe",
                        UseShellExecute = true
                    });
                    System.Threading.Thread.Sleep(1000);
                }

                int count = Process.GetProcessesByName("explorer").Length;
                if (count > 0)
                {
                    _txtStatus.Text = "Explorer berhasil direstart. " +
                        "Memori shell kembali ke ukuran awal.";
                    UpdateDisplay();
                }
                else
                {
                    _txtStatus.Text = "Gagal menjalankan ulang otomatis. " +
                        "Buka manual: Ctrl+Shift+Esc > Run new task > explorer.exe";
                }
            }
            catch (Exception ex)
            {
                _txtStatus.Text = "Terjadi kesalahan: " + ex.Message;
            }
            finally
            {
                _btnClean.IsEnabled = true;
                _isCleaning = false;
            }
        }

        private static Style ButtonStyle(Brush normal, Brush hover, Brush foreground)
        {
            Style st = new Style(typeof(Button));
            st.Setters.Add(new Setter(Button.BackgroundProperty, normal));
            st.Setters.Add(new Setter(Button.ForegroundProperty, foreground));
            st.Setters.Add(new Setter(Button.BorderThicknessProperty, new Thickness(0)));
            st.Setters.Add(new Setter(Button.CursorProperty, Cursors.Hand));

            Trigger t = new Trigger();
            t.Property = UIElement.IsMouseOverProperty;
            t.Value = true;
            t.Setters.Add(new Setter(Button.BackgroundProperty, hover));
            st.Triggers.Add(t);

            Trigger pressed = new Trigger();
            pressed.Property = Button.IsPressedProperty;
            pressed.Value = true;
            pressed.Setters.Add(new Setter(Button.BackgroundProperty, hover));
            st.Triggers.Add(pressed);

            return st;
        }

        private static Brush Solid(Color c)
        {
            SolidColorBrush b = new SolidColorBrush(c);
            b.Freeze();
            return b;
        }

        private static void RefreshFillWidth()
        {
            double avail = _meter.ActualWidth - 2.0;
            if (avail <= 0)
            {
                return;
            }
            double frac = Math.Max(0, Math.Min(100, _lastPct)) / 100.0;
            _barFill.Width = frac * avail;
        }

        private static void RefreshStackWidths()
        {
            double total = _lastInUseFrac + _lastStandbyFrac;
            double free = 1.0 - total;
            if (total <= 0) { free = 1.0; }
            _stack.ColumnDefinitions[0].Width =
                new GridLength(Math.Max(0, _lastInUseFrac), GridUnitType.Star);
            _stack.ColumnDefinitions[1].Width =
                new GridLength(Math.Max(0, _lastStandbyFrac), GridUnitType.Star);
            _stack.ColumnDefinitions[2].Width =
                new GridLength(Math.Max(0, free), GridUnitType.Star);
        }

        private static string FmtGb(ulong bytes)
        {
            return string.Format("{0:N2} GB", bytes / 1073741824.0);
        }

        private static void UpdateDisplay()
        {
            try
            {
                MemApi.MEMORYSTATUSEX s = MemApi.GetStatus();
                ulong used = s.ullTotalPhys - s.ullAvailPhys;
                int pct = (int)s.dwMemoryLoad;
                _lastPct = pct;

                Brush meterBrush;
                if (pct < 60) { meterBrush = Solid(ColGreen); }
                else if (pct < 85) { meterBrush = Solid(ColYellow); }
                else { meterBrush = Solid(ColRed); }

                _txtUsage.Text = pct + "%";
                _txtUsage.Foreground = meterBrush;
                _barFill.Background = meterBrush;
                RefreshFillWidth();

                _txtDetail.Text = string.Format(
                    "Terpakai {0}   |   Total {1}   |   Bebas {2}",
                    FmtGb(used), FmtGb(s.ullTotalPhys), FmtGb(s.ullAvailPhys));

                _lvProcs.ItemsSource = GetTopProcesses();
            }
            catch { }
        }

        private static List<ProcItem> GetTopProcesses()
        {
            List<ProcItem> list = new List<ProcItem>();
            Process[] procs = Process.GetProcesses();
            foreach (Process p in procs)
            {
                try
                {
                    long ws = p.WorkingSet64;
                    if (ws > 10485760L)
                    {
                        ProcItem it = new ProcItem();
                        it.Name = p.ProcessName;
                        it.Id = p.Id;
                        it.MemMB = Math.Round(ws / 1048576.0, 1);
                        list.Add(it);
                    }
                }
                catch { }
                finally
                {
                    try { p.Dispose(); } catch { }
                }
            }

            list.Sort(delegate(ProcItem a, ProcItem b) { return b.MemMB.CompareTo(a.MemMB); });
            if (list.Count > 25)
            {
                list.RemoveRange(25, list.Count - 25);
            }
            return list;
        }

        private static void SetStatus(string text)
        {
            _txtStatus.Text = text;
            PumpBackground();
        }

        private static void PumpBackground()
        {
            _window.Dispatcher.Invoke(new Action(delegate { }), DispatcherPriority.Background);
        }

        private static string RunMemCommand(int command)
        {
            try
            {
                int cmd = command;
                int st = MemApi.NtSetSystemInformation(
                    MemApi.SystemMemoryListInformation, ref cmd, 4);
                if (st == 0)
                {
                    return null;
                }
                return "NTSTATUS 0x" + st.ToString("X");
            }
            catch (Exception ex)
            {
                return ex.Message;
            }
        }

        private static string TrimSystemFileCache()
        {
            try
            {
                IntPtr min, max;
                uint flags;
                if (!MemApi.GetSystemFileCacheSize(out min, out max, out flags))
                {
                    return "Gagal membaca batas file cache";
                }

                // Coba lepas seluruh file cache dengan menurunkan batas ke nol
                bool ok1 = MemApi.SetSystemFileCacheSize(min, IntPtr.Zero, flags);
                System.Threading.Thread.Sleep(250);
                bool ok2 = RestoreFileCacheLimit(min, max, flags);

                if (!ok1)
                {
                    // Fallback: turunkan batas 256 MB dari nilai semula
                    long maxCur = max.ToInt64();
                    long target = maxCur < 0 ? 0 : Math.Max(maxCur - 268435456L, 0);
                    ok1 = MemApi.SetSystemFileCacheSize(min, (IntPtr)target, flags);
                    System.Threading.Thread.Sleep(250);
                    ok2 = RestoreFileCacheLimit(min, max, flags);
                }

                if (!ok1 || !ok2)
                {
                    return "Gagal memulihkan batas file cache";
                }
                return null;
            }
            catch (Exception ex)
            {
                return ex.Message;
            }
        }

        private static bool RestoreFileCacheLimit(IntPtr min, IntPtr max, uint flags)
        {
            for (int i = 0; i < 3; i++)
            {
                if (MemApi.SetSystemFileCacheSize(min, max, flags))
                {
                    return true;
                }
                System.Threading.Thread.Sleep(150);
            }
            return false;
        }

        private static void ScheduleSettleRefresh()
        {
            DispatcherTimer settle = new DispatcherTimer();
            settle.Interval = TimeSpan.FromSeconds(2);
            settle.Tick += delegate
            {
                UpdateDisplay();
                settle.Stop();
            };
            settle.Start();
        }

        private static void CleanRam(bool fromAuto)
        {
            if (_isCleaning) { return; }
            _isCleaning = true;
            _btnClean.IsEnabled = false;
            try
            {
                bool deep = _chkAggressive.IsChecked == true;
                int ownId = Process.GetCurrentProcess().Id;

                SetStatus("Menyiapkan hak istimewa sistem...");
                bool privOk = Privilege.Enable("SeProfileSingleProcessPrivilege")
                    && Privilege.Enable("SeIncreaseQuotaPrivilege");

                MemApi.MEMORYSTATUSEX before = MemApi.GetStatus();
                int pctBefore = (int)before.dwMemoryLoad;

                string[] excl = deep ? ExcludedCritical : Excluded;
                int maxRounds = deep ? 6 : 2;
                int roundsDone = 0;
                int cleaned = 0;
                string err2 = null;
                string err3 = null;
                string err4 = null;
                double prevAvailMb = -1;

                for (int r = 1; r <= maxRounds; r++)
                {
                    if (deep)
                    {
                        SetStatus(string.Format(
                            "Putaran {0}/{1}: membersihkan working set semua proses...", r, maxRounds));
                    }
                    else
                    {
                        SetStatus(string.Format("Membersihkan ({0}/{1})...", r, maxRounds));
                    }

                    cleaned += SweepProcesses(excl, ownId);
                    System.Threading.Thread.Sleep(deep ? 300 : 80);

                    // Purge standby list di setiap putaran
                    err2 = RunMemCommand(MemApi.CmdPurgeLowPriorityStandbyList);
                    System.Threading.Thread.Sleep(120);
                    err3 = RunMemCommand(MemApi.CmdPurgeStandbyList);
                    System.Threading.Thread.Sleep(deep ? 350 : 200);

                    roundsDone++;

                    // Berhenti lebih awal bila hasil sudah konvergen
                    MemApi.MEMORYSTATUSEX probe = MemApi.GetStatus();
                    double availMb = probe.ullAvailPhys / 1048576.0;
                    if (prevAvailMb >= 0)
                    {
                        double gain = availMb - prevAvailMb;
                        int minRounds = deep ? 2 : 1;
                        if (r >= minRounds && gain < 30)
                        {
                            break;
                        }
                    }
                    prevAvailMb = availMb;
                }

                if (deep)
                {
                    SetStatus("Tahap dalam: mengosongkan file cache sistem...");
                    err4 = TrimSystemFileCache();

                    SetStatus("Tahap dalam: siklus pembersihan terakhir...");
                    cleaned += SweepProcesses(ExcludedCritical, ownId);
                    RunMemCommand(MemApi.CmdPurgeLowPriorityStandbyList);
                    RunMemCommand(MemApi.CmdPurgeStandbyList);
                    System.Threading.Thread.Sleep(400);
                }
                else
                {
                    System.Threading.Thread.Sleep(300);
                }

                // Bersihkan working set aplikasi ini sendiri sebagai penutup
                try { MemApi.EmptyWorkingSet(Process.GetCurrentProcess().Handle); } catch { }

                System.Threading.Thread.Sleep(500);
                MemApi.MEMORYSTATUSEX after = MemApi.GetStatus();
                int pctAfter = (int)after.dwMemoryLoad;

                long usedBefore = (long)(before.ullTotalPhys - before.ullAvailPhys);
                long usedAfter = (long)(after.ullTotalPhys - after.ullAvailPhys);
                double freedMb = (usedBefore - usedAfter) / 1048576.0;
                if (freedMb < 0) { freedMb = 0; }

                UpdateDisplay();

                string modeText = deep
                    ? "Mode mendalam (" + roundsDone + " putaran adaptif + file cache)."
                    : "Mode cepat (" + roundsDone + " putaran).";
                string msg = string.Format(
                    "Selesai! {0} proses dibersihkan. {1}\n" +
                    "RAM terpakai berkurang sekitar {2:N0} MB ({3}% menjadi {4}%).",
                    cleaned, modeText, freedMb, pctBefore, pctAfter);

                int failedStages = 0;
                if (!privOk) { failedStages++; }
                if (err2 != null) { failedStages++; }
                if (err3 != null) { failedStages++; }
                if (deep && err4 != null) { failedStages++; }

                if (failedStages > 0)
                {
                    msg += "\nCatatan: " + failedStages +
                        " tahap sistem tidak berhasil dijalankan. Jalankan sebagai Administrator.";
                }

                if (fromAuto) { msg = "[AUTO] " + msg; }

                _txtStatus.Text = msg;
                ScheduleSettleRefresh();
            }
            catch (Exception ex)
            {
                _txtStatus.Text = "Terjadi kesalahan: " + ex.Message;
            }
            finally
            {
                _btnClean.IsEnabled = true;
                _isCleaning = false;
                _lastCleanTime = DateTime.Now;
            }
        }

        private static int SweepProcesses(string[] excluded, int ownId)
        {
            int n = 0;
            Process[] procs = Process.GetProcesses();
            foreach (Process p in procs)
            {
                try
                {
                    if (p.Id == ownId) { continue; }
                    if (Array.IndexOf(excluded, p.ProcessName.ToLower()) >= 0) { continue; }
                    IntPtr h = p.Handle;
                    if (h != IntPtr.Zero && MemApi.EmptyWorkingSet(h))
                    {
                        n++;
                    }
                }
                catch { }
                finally
                {
                    try { p.Dispose(); } catch { }
                }
            }
            return n;
        }

        private static void CheckAutoClean()
        {
            if (_isCleaning || _chkAuto.IsChecked != true) { return; }
            int t;
            if (!int.TryParse(_txtThreshold.Text.Trim(), out t)) { return; }
            if (t < 50 || t > 99) { return; }
            if (_lastPct < t) { return; }
            if ((DateTime.Now - _lastCleanTime).TotalSeconds < 60) { return; }
            CleanRam(true);
        }

        private static void CleanSingle(ProcItem it)
        {
            if (it == null) { return; }
            try
            {
                Process p = Process.GetProcessById(it.Id);
                long beforeWs = 0;
                bool ok = false;
                try
                {
                    beforeWs = p.WorkingSet64;
                    ok = MemApi.EmptyWorkingSet(p.Handle);
                }
                finally
                {
                    try { p.Dispose(); } catch { }
                }

                System.Threading.Thread.Sleep(200);

                double freed = 0;
                try
                {
                    Process p2 = Process.GetProcessById(it.Id);
                    freed = Math.Max(0, (beforeWs - p2.WorkingSet64) / 1048576.0);
                    p2.Dispose();
                }
                catch { }

                UpdateDisplay();
                _txtStatus.Text = ok
                    ? string.Format("Proses '{0}' dibersihkan (sekitar {1:N0} MB dilepas).", it.Name, freed)
                    : "Gagal membersihkan proses tersebut.";
            }
            catch
            {
                _txtStatus.Text = "Proses sudah tidak berjalan.";
            }
        }
    }
}
