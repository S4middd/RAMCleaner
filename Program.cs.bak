        [STAThread]
        public static void Main()
        {
            try
            {
                RunApp();
            }
            catch (Exception ex)
            {
                MessageBox.Show(ex.ToString(), "RAM Cleaner - Error",
                    MessageBoxButton.OK, MessageBoxImage.Error);
            }
        }

        private static void RunApp()
        {
            Application app = new Application();

            _window = BuildWindow();
            WireEvents();

            _window.SourceInitialized += delegate
            {
                HwndSource src = (HwndSource)PresentationSource.FromVisual(_window);
                if (src != null)
                {
                    int on = 1;
                    if (MemApi.DwmSetWindowAttribute(src.Handle, 20, ref on, 4) != 0)
                    {
                        MemApi.DwmSetWindowAttribute(src.Handle, 19, ref on, 4);
                    }
                }
            };

            bool isAdmin = new WindowsPrincipal(WindowsIdentity.GetCurrent())
                .IsInRole(WindowsBuiltInRole.Administrator);
            if (!isAdmin)
            {
                _txtStatus.Text = "Berjalan tanpa hak Admin - pembersihan tidak akan menyeluruh.";
            }

            UpdateDisplay();

            _timer = new DispatcherTimer();
            _timer.Interval = TimeSpan.FromSeconds(2);
            _timer.Tick += delegate { UpdateDisplay(); CheckAutoClean(); };
            _timer.Start();

            app.Run(_window);
        }

        private static Border MakeCard(Thickness margin)
        {
            Border b = new Border();
            b.Background = Solid(ColPanel);
            b.CornerRadius = new CornerRadius(10);
            b.Padding = new Thickness(16);
            b.Margin = margin;
            return b;
        }

        private static void CardLabel(StackPanel sp, string text, Color color)
        {
            TextBlock t = new TextBlock();
            t.Text = text;
            t.FontSize = 12;
            t.FontWeight = FontWeights.Bold;
            t.Foreground = Solid(color);
            sp.Children.Add(t);
        }

